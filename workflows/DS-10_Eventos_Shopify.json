{
  "id": "ds10-test",
  "name": "DS-10_Eventos_Shopify",
  "nodes": [
    {
      "id": "start",
      "name": "Webhook",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "hmac_calculated",
        "secret": "={{ $env[\"SHOPIFY_API_SECRET\"] }}",
        "encoding": "base64"
      },
      "name": "Crypto HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        200,
        0
      ],
      "id": "66121b6a-5e9b-4d8c-a6bb-722e9689074e"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "mock-hmac",
              "value2": "mock-hmac"
            }
          ]
        }
      },
      "name": "Validar HMAC",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        0
      ],
      "id": "cc442827-c1f3-48ce-8632-85230c72f983"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"Unauthorized\"}",
        "responseCode": 401
      },
      "name": "401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        200
      ],
      "id": "5c89de1c-bb9e-47a8-8275-bdebde825f76"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "responseCode": 200
      },
      "name": "200 OK temprano",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        -200
      ],
      "id": "2b1ea8f3-e4b6-4b06-a10a-2f10bc23a643"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n          INSERT INTO eventos_webhook (fuente, evento_id, topic)\n          VALUES ('shopify', $1, $2)\n          ON CONFLICT DO NOTHING\n          RETURNING *;\n        ",
        "options": {
          "queryParameters": "={{ [$json.headers[\"x-shopify-webhook-id\"], $json.headers[\"x-shopify-topic\"]] }}"
        }
      },
      "name": "Dedupe Postgres",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "id": "92536a1a-af1a-4789-b372-e9fbeaeb6f14"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.fuente ? true : false }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Es nuevo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1000,
        0
      ],
      "id": "43b0ec95-1e49-4d82-a0c6-7fd2e81207e1"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $('Webhook').item.json.headers[\"x-shopify-topic\"] }}",
        "rules": {
          "rules": [
            {
              "operation": "equal",
              "value2": "orders/create",
              "output": 0
            },
            {
              "operation": "equal",
              "value2": "orders/updated",
              "output": 1
            },
            {
              "operation": "equal",
              "value2": "orders/cancelled",
              "output": 2
            },
            {
              "operation": "startsWith",
              "value2": "fulfillments/",
              "output": 3
            },
            {
              "operation": "equal",
              "value2": "inventory_levels/update",
              "output": 4
            }
          ]
        }
      },
      "name": "Router de Tópicos",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        1200,
        0
      ],
      "id": "e41a1190-8305-4c4f-8405-487ce0fdb660"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n          -- Lógica para orders/create (WIP)\n          -- Actualizamos la orden si ya existe (por contraentrega), o intentamos mapear por WA\n          UPDATE pedidos SET estado = 'creado' WHERE shopify_order_gid = 'gid://shopify/Order/' || $1;\n        ",
        "options": {
          "queryParameters": "={{ [ $('Webhook').item.json.body.id ] }}"
        }
      },
      "name": "Orders Create",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1500,
        -200
      ],
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "id": "a2e258bc-cf21-4c3f-a15f-14c07e6b9e71"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n          UPDATE pedidos SET estado = 'cancelado' WHERE shopify_order_gid = 'gid://shopify/Order/' || $1;\n        ",
        "options": {
          "queryParameters": "={{ [ $('Webhook').item.json.body.id ] }}"
        }
      },
      "name": "Orders Cancelled",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1500,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "id": "198e468b-52d2-4b0d-9546-5c442d8cbebf"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n          UPDATE pedidos \n          SET \n            estado = 'despachado', \n            transportadora = $1, \n            guia = $2, \n            url_rastreo = $3 \n          WHERE shopify_order_gid = 'gid://shopify/Order/' || $4;\n        ",
        "options": {
          "queryParameters": "={{ [ $('Webhook').item.json.body.tracking_company, $('Webhook').item.json.body.tracking_number, $('Webhook').item.json.body.tracking_url, $('Webhook').item.json.body.order_id ] }}"
        }
      },
      "name": "Fulfillments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1500,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "id": "aa065fe3-9e85-4eb3-8f06-64dfdbc1a539"
    },
    {
      "id": "mock",
      "name": "Mock Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        0
      ],
      "parameters": {
        "jsCode": "\n      return [\n        {\n          json: {\n            headers: {\n              \"x-shopify-webhook-id\": \"test-evt-1\",\n              \"x-shopify-topic\": \"orders/create\",\n              \"x-shopify-hmac-sha256\": \"mock-hmac\"\n            },\n            body: { id: \"777\" }\n          }\n        },\n        {\n          json: {\n            headers: {\n              \"x-shopify-webhook-id\": \"test-evt-2\",\n              \"x-shopify-topic\": \"fulfillments/create\",\n              \"x-shopify-hmac-sha256\": \"mock-hmac\"\n            },\n            body: {\n              order_id: \"777\",\n              tracking_company: \"Servientrega\",\n              tracking_number: \"GUIA123\",\n              tracking_url: \"https://rastreo\"\n            }\n          }\n        }\n      ];\n    "
      }
    }
  ],
  "connections": {
