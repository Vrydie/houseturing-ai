{
  "id": "11111111-2222-3333-4444-555555555555",
  "name": "DS-11_Vigilante_Pedidos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "f3500b71-6fc9-4376-8167-f81ad6dcb5f6"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n          SELECT id, wa_id, shopify_order_name, shopify_order_gid, estado, total\n          FROM pedidos \n          WHERE estado = 'creado' \n            AND shopify_order_gid IS NOT NULL\n            AND creado_en < NOW() - INTERVAL '24 HOURS';\n        "
      },
      "name": "Buscar pedidos atorados",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        200,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "id": "15bbbe0a-2b8e-48ba-bdde-aa778ca9d3d1"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.id ? true : false }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Hay atorados?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        0
      ],
      "id": "2c622635-8a20-48dd-ad10-fe7604a1ddf9"
    },
    {
      "parameters": {
        "chatId": "={{ $env[\"TELEGRAM_CHAT_ID\"] }}",
        "text": "={{ \"⚠️ *Alerta Fulfillment*\\n\\nEl pedido \" + $json.shopify_order_name + \" lleva más de 24 horas en estado \\\"creado\\\" y Dropi no lo ha despachado.\\n\\nPor favor, revisa si hubo un error en la exportación.\" }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Notificar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        600,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "T0lm7WR4FJtRzjXV",
          "name": "Telegram Bot API"
        }
      },
      "id": "385b5f94-b794-4767-bfec-f5206e22183a"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Buscar pedidos atorados",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar pedidos atorados": {
      "main": [
        [
          {
            "node": "Hay atorados?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hay atorados?": {
      "main": [
        [
          {
            "node": "Notificar Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "errorWorkflow": "DS-00_Manejador_Errores"
  }
}
