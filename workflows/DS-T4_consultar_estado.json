    {
      "parameters": {
        "jsCode": "\nconst items = $input.all().map(i => i.json);\nif (items.length === 0) return [{ json: { error: \"No se encontró ningún pedido reciente.\" } }];\nreturn [{ json: items[0] }];\n        "
