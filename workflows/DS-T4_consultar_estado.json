      "parameters": {
        "jsCode": "function aplanarEntradaHerramienta(j) {\n  const q = j?.query;\n  if (!q || typeof q !== 'object' || Array.isArray(q)) return j;\n  const { query, ...contexto } = j;\n  return { ...q, ...contexto };\n}\nreturn [{json:aplanarEntradaHerramienta($json)}];"
      }
    },
    {
      "id": "Pedidos",
      "name": "Pedidos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(shopify_order_name,'#'||id) AS numero_pedido, estado, transportadora, guia, url_rastreo, total, moneda,\n to_char(creado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY') AS fecha\nFROM pedidos WHERE wa_id=$1 AND ($2='' OR shopify_order_name=$2 OR shopify_order_name='#'||ltrim($2,'#'))\nORDER BY creado_en DESC LIMIT 3",
        "options": {
          "queryReplacement": "={{ [$json.wa_id,$json.numero_pedido ?? ''] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "Formato",
      "name": "Formato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const pedidos=$input.all().map(i=>i.json).filter(p=>p.numero_pedido);return [{json:pedidos.length?{ok:true,pedidos}:{ok:false,pedidos:[],error:'No encontré pedidos de este número de WhatsApp.'}}];"
      }
    }
  ],
