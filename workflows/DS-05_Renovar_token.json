{
  "id": "ds-05-renovar-token-uuid-1234",
  "name": "DS-05_Renovar_token",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 20
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "id": "1714dbdf-4019-49fb-b0ac-7db7dba3a80b"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://\" + $env[\"SHOPIFY_STORE_DOMAIN\"] + \"/admin/oauth/access_token\" }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_id",
              "value": "={{ $env[\"SHOPIFY_CLIENT_ID\"] }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $env[\"SHOPIFY_CLIENT_SECRET\"] }}"
            },
            {
              "name": "grant_type",
              "value": "client_credentials"
            }
          ]
        }
      },
      "name": "Obtener Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        200,
        0
      ],
      "id": "451196ab-3272-4c69-b14e-1a1b19fdd407"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n          UPDATE config SET valor = $1, actualizado_en = now() WHERE clave = 'shopify_access_token';\n          UPDATE config SET valor = $2, actualizado_en = now() WHERE clave = 'shopify_token_expira_en';\n        ",
        "queryParameters": "={{ $json.access_token }},{{ new Date(Date.now() + $json.expires_in * 1000).toISOString() }}"
      },
      "name": "Guardar Token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VqgP7Z77oaN8muQ2",
          "name": "Postgres dropship"
        }
      },
      "id": "fa0a3c92-666c-496f-abd7-5835ce9a4f22"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Obtener Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Token": {
      "main": [
        [
          {
            "node": "Guardar Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "errorWorkflow": "DS-00_Manejador_Errores"
  }
}
