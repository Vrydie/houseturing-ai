    {
      "id": "Revisar despu├®s de espera 2",
      "name": "Revisar despu├®s de espera 2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        1200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (c.bot_activo AND c.agente_ocupado_hasta=$2::timestamptz AND c.agente_ocupado_hasta>now()\n    AND NOT EXISTS(SELECT 1 FROM mensajes WHERE conversacion_id=c.id AND direccion='in' AND NOT (wamid=ANY($3::text[])) AND NOT procesado)) AS permitido\n    FROM conversaciones c WHERE c.id=$1",
        "options": {
          "queryReplacement": "={{ [$('Entrada').first().json.conversacion_id,$('Entrada').first().json.lease,$('Entrada').first().json.wamids] }}"
