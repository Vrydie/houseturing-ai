    {
      "id": "Preparar env├¡o",
      "name": "Preparar env├¡o",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "function bubbles(input, empresa, random = Math.random) {\r\n  const partes = input.plantilla ? [null] : String(input.texto ?? '').split(/\\n\\s*\\n/).filter(s=>s.trim());\r\n  // M├íximo tres burbujas, sin perder p├írrafos adicionales.\r\n  if (partes.length > 3) partes.splice(2, partes.length-2, partes.slice(2).join('\\n\\n'));\r\n  return partes.map(texto=>({\r\n    texto,waitTime:Math.min(7,Math.max(1.5,0.035*(texto?.length ?? 0)+0.5+random())),\r\n    body:{from:empresa,to:'+'+input.wa_id,type:input.plantilla?'template':'text',\r\n      ...(input.plantilla?{template:input.plantilla}:{text:{body:texto},...(input.responder_a_wamid?{context:{message_id:input.responder_a_wamid}}:{})})}\r\n  }));\r\n}\nconst p=$('Entrada').first().json;\nif(!$json.simulado && !/^\\+?\\d{8,15}$/.test($json.empresa)) throw new Error('Configurar el n├║mero de empresa antes de modo real');\nreturn [{json:{...p,simulado:$json.simulado,burbujas:bubbles(p,$json.empresa)}}];"
      }
    },
    {
