      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE((SELECT valor FROM config WHERE clave='whatsapp_modo_simulado'),'true')='true' AS simulado,\n COALESCE((SELECT valor FROM config WHERE clave='ycloud_numero_empresa'),'') AS empresa",
