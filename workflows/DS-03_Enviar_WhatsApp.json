    {
      "id": "Guardar salida 2",
      "name": "Guardar salida 2",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        1440
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n   INSERT INTO mensajes(wamid,wa_id,conversacion_id,direccion,tipo,texto,estado,proveedor_id,waba_id,autor,procesado,normalizado)\n   VALUES(COALESCE($1,'ycloud:'||$2),$3,$4,'out',$5,$6,$7,$2,$8,'bot',true,$9::jsonb)\n   ON CONFLICT(wamid) DO NOTHING RETURNING wamid)\n   UPDATE mensajes SET procesado=true WHERE direccion='in' AND conversacion_id=$4 AND wamid=ANY($10::text[])\n   AND EXISTS(SELECT 1 FROM saved) RETURNING wamid",
        "options": {
          "queryReplacement": "={{ [$json.wamid ?? null,$json.id,$('Burbuja 2').first().json.wa_id,$('Burbuja 2').first().json.conversacion_id,$('Burbuja 2').first().json.body.type,$('Burbuja 2').first().json.texto ?? null,$json.status,$('Burbuja 2').first().json.waba_id,JSON.stringify($('Burbuja 2').first().json.body),$('Entrada').first().json.wamids] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "ot05-postgres",
          "name": "Postgres dropship"
        }
      },
      "alwaysOutputData": true
    }
