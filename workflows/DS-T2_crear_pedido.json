    {
      "parameters": {
        "jsCode": "\n// Aquí armamos el cuerpo de la mutación GraphQL usando los datos del cliente\nconst inputData = $('Execute Workflow Trigger').first().json;\nconst priceData = $input.first().json;\nconst sessionId = inputData.sessionId;\nconst envio = inputData.datos_envio;\n\n// Se asume que el token y dominio se sacan de config, aquí se deja preparado.\nreturn [{\n  json: {\n    query: \"mutation CrearPedidoContraentrega($order: OrderCreateOrderInput!) { orderCreate(order: $order) { order { id name } userErrors { message } } }\",\n    variables: {\n      order: {\n        currency: \"COP\",\n        financialStatus: \"PENDING\",\n        phone: \"+57\" + envio.celular,\n        shippingAddress: {\n          firstName: envio.nombre,\n          lastName: envio.apellido,\n          address1: envio.direccion,\n          city: envio.ciudad,\n          phone: \"+57\" + envio.celular\n        },\n        tags: [\"canal:whatsapp\", \"wa:\" + sessionId]\n      }\n    }\n  }\n}];\n        "
      },
      "id": "code_format_gql",
      "name": "Build GraphQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://{{$json.shopify_domain}}/admin/api/2026-07/graphql.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shopify-Access-Token",
              "value": "AQUÍ_VA_TU_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query }}"
            },
            {
              "name": "variables",
              "value": "={{ JSON.stringify($json.variables) }}"
            }
          ]
        }
      },
      "id": "http_shopify",
      "name": "Shopify API (Mock)",
