      "name": "Leer cuerpo crudo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const raw=await this.helpers.getBinaryDataBuffer(0,'data');return [{json:{raw:raw.toString('utf8'),headers:$json.headers}}];"
