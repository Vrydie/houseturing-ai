{
  "id": "ds-02-agente-ventas",
  "name": "DS-02 Agente de Ventas",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst wa_id = $('Execute Workflow Trigger').first().json.wa_id;\nreturn [{ json: { wa_id } }];\n        "
      },
      "id": "code_count",
      "name": "Get wa_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        150,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as turnos FROM mensajes WHERE wa_id = $1",
        "options": {
          "queryReplacement": "={{ [$json.wa_id] }}"
        }
      },
      "id": "pg_count",
      "name": "Count Turns",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "credentials": {
        "postgres": {
          "id": "b1b2JJ18qDVF2dWp",
          "name": "Postgres"
        }
      },
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.turnos }}",
              "operation": "larger",
              "value2": 60
            }
          ]
        }
      },
      "id": "if_limite",
      "name": "IF > 60 Turnos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { texto: 'Escalado por límite de turnos', bot_activo: false } }];"
      },
      "id": "code_escalar",
      "name": "Escalar a Humano",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst wa_id = $('Execute Workflow Trigger').first().json.wa_id;\nconst texto = $('Execute Workflow Trigger').first().json.texto;\nreturn [{ json: { sessionId: wa_id, chatInput: texto } }];\n        "
      },
      "id": "code_format",
      "name": "Format Agent Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        100
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Execute Workflow Trigger').first().json.texto }}",
        "options": {
          "systemMessage": "Eres un asesor de ventas de una tienda virtual."
        }
      },
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        800,
        100
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "model": "deepseek-chat",
        "options": {
          "baseURL": "https://api.deepseek.com/v1"
        }
      },
      "id": "llm",
      "name": "DeepSeek Chat Model",
