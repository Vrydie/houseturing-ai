        "query": "SELECT valor FROM config WHERE clave = 'whatsapp_modo_simulado'"
      },
      "id": "pg_simulado",
      "name": "Check Simulado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "credentials": {
        "postgres": {
          "id": "b1b2JJ18qDVF2dWp",
          "name": "Postgres"
        }
      },
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.valor === 'true' }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if_simulado",
      "name": "IF Simulado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mensajes (wamid, wa_id, direccion, tipo, texto) VALUES (gen_random_uuid()::text, $1, 'out', 'text', $2)",
        "options": {
          "queryReplacement": "{{ $('Execute Workflow Trigger').first().json.wa_id }},{{ $('Execute Workflow Trigger').first().json.texto }}"
        }
      },
      "id": "pg_insert_simulado",
      "name": "Insert Simulado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "credentials": {
        "postgres": {
          "id": "b1b2JJ18qDVF2dWp",
          "name": "Postgres"
        }
      },
      "position": [
        600,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst wa_id = $('Execute Workflow Trigger').first().json.wa_id;\nconst texto = $('Execute Workflow Trigger').first().json.texto;\nconst wamid_resp = $('Execute Workflow Trigger').first().json.responder_a_wamid;\nconst partes = texto.split('\\n\\n').filter(p => p.trim() !== '').slice(0,3);\nreturn partes.map(p => ({ json: { wa_id, texto: p, wamid_resp } }));\n        "
      },
      "id": "code_split",
      "name": "Split Burbujas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Mock for typing / sleep in n8n code node using a loop or we use Wait node\n// Wait node is better for non-blocking sleep.\nconst waitTime = Math.min(7, Math.max(1.5, 0.5 + ($json.texto.length * 0.035)));\nreturn [{ json: { ...$json, waitTime } }];\n        "
      },
      "id": "code_timing",
      "name": "Calc Timing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        100
      ]
    },
    {
      "parameters": {
        "amount": "={{ $json.waitTime }}",
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait Typing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "webhookId": "wait-webhook",
      "position": [
        1000,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO mensajes (wamid, wa_id, direccion, tipo, texto) VALUES (gen_random_uuid()::text, $1, 'out', 'text', $2)",
        "options": {
          "queryReplacement": "{{ $json.wa_id }},{{ $json.texto }}"
        }
      },
      "id": "pg_insert_real",
      "name": "Insert Real",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "credentials": {
        "postgres": {
          "id": "b1b2JJ18qDVF2dWp",
          "name": "Postgres"
        }
      },
      "position": [
        1200,
        100
      ]
    }
  ],
