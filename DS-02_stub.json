      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst output = $input.first().json.output || \"\";\nconst prohibidas = [\"soy una ia\", \"soy un modelo\", \"openai\", \"precio de 10000\"];\nconst isBlocked = prohibidas.some(p => output.toLowerCase().includes(p));\n\nreturn [{\n  json: {\n    wa_id: $('Execute Workflow Trigger').first().json.wa_id,\n    texto: isBlocked ? \"Hubo un error de estilo. Regenerando...\" : output\n  }\n}];\n        "
      },
      "id": "code_filter",
      "name": "Filtro de Estilo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        100
      ]
    }
