<div style="background: white; padding: 60px 16px; text-align: center;">
  <div style="max-width: 800px; margin: 0 auto;">
    <h2 style="font-family: var(--font-titulos); font-size: 32px; font-weight: 800; margin-bottom: 32px; color: var(--color-grafito, #1A1A1A);">¿Por separado o en un solo maletín?</h2>
    
    <style>
      .compare-table { width: 100%; border-collapse: collapse; text-align: left; background: white; font-family: var(--font-body); font-size: 14px; }
      .compare-table th, .compare-table td { padding: 12px 8px; border-bottom: 1px solid #EAEAEA; color: #1A1A1A; }
      .compare-table th { background: #F9F9F9; font-weight: bold; }
      .compare-table th:not(:first-child), .compare-table td:not(:first-child) { text-align: center; }
      .compare-highlight { color: var(--color-naranja, #F2661B); font-weight: bold; }
      @media (min-width: 768px) {
        .compare-table { font-size: 16px; }
        .compare-table th, .compare-table td { padding: 16px; }
      }
    </style>

    <div style="overflow-x: auto; max-width: 100%; border: 1px solid #EAEAEA; border-radius: 8px;">
      <table class="compare-table">
        <thead>
          <tr>
            <th>Característica</th>
            <th>Por separado</th>
            <th class="compare-highlight">Nuestro Kit</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Pedidos</td>
            <td>Llegan distintos días</td>
            <td class="compare-highlight">Todo en 1 caja</td>
          </tr>
          <tr>
            <td>Baterías</td>
            <td>1 sola (o pagas extra)</td>
            <td class="compare-highlight">2 incluidas</td>
          </tr>
          <tr>
            <td>Accesorios</td>
            <td>Comprar aparte</td>
            <td class="compare-highlight">24 piezas</td>
          </tr>
          <tr>
            <td>Dónde guardarlo</td>
            <td>En cajas sueltas</td>
            <td class="compare-highlight">Maletín de alto impacto</td>
          </tr>
          <tr>
            <td>Cómo pagas</td>
            <td>Tarjeta por anticipado</td>
            <td class="compare-highlight">En efectivo al recibir</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
{% schema %}
{ "name": "Landing Compare", "presets": [{ "name": "Landing Compare" }] }
{% endschema %}
