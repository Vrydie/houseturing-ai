<div style="background: var(--color-grafito, #1A1A1A); padding: 60px 20px;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <h2 style="font-family: var(--font-titulos); font-size: 32px; font-weight: 800; margin-bottom: 40px; color: white; text-align: center;">Un taladro, tres modos</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      
      <div style="background: #1D2126; padding: 24px; border-radius: 12px; display: flex; align-items: flex-start; gap: 16px;">
        <div style="background: var(--color-naranja, #F2661B); width: 56px; height: 56px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
        </div>
        <div style="text-align: left;">
          <h3 style="font-family: var(--font-titulos); font-size: 20px; font-weight: bold; margin-bottom: 4px; color: white;">Atornillador</h3>
          <p style="color: #ccc; font-size: 15px; margin: 0;">Para armar muebles y ajustes rápidos.</p>
        </div>
      </div>

      <div style="background: #1D2126; padding: 24px; border-radius: 12px; display: flex; align-items: flex-start; gap: 16px;">
        <div style="background: var(--color-naranja, #F2661B); width: 56px; height: 56px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" y1="8" x2="12" y2="8"/><line x1="3.95" y1="6.06" x2="8.54" y2="14"/></svg>
        </div>
        <div style="text-align: left;">
          <h3 style="font-family: var(--font-titulos); font-size: 20px; font-weight: bold; margin-bottom: 4px; color: white;">Taladro</h3>
          <p style="color: #ccc; font-size: 15px; margin: 0;">Perfora madera, plástico y metal blando.</p>
        </div>
      </div>

      <div style="background: #1D2126; padding: 24px; border-radius: 12px; display: flex; align-items: flex-start; gap: 16px;">
        <div style="background: var(--color-naranja, #F2661B); width: 56px; height: 56px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l3-9 5 18 3-9h5"/></svg>
        </div>
        <div style="text-align: left;">
          <h3 style="font-family: var(--font-titulos); font-size: 20px; font-weight: bold; margin-bottom: 4px; color: white;">Percutor</h3>
          <p style="color: #ccc; font-size: 15px; margin: 0;">Impacto para taladrar mampostería y ladrillo.</p>
        </div>
      </div>

    </div>
  </div>
</div>
{% schema %}
{ "name": "Landing Modes", "presets": [{ "name": "Landing Modes" }] }
{% endschema %}
