{% assign selected_product = section.settings.main_product | default: product %}
<div style="background: #F1F2F3; color: #111; padding: 60px 20px;">
  <div style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center;">
    {% if selected_product.images[0] %}
      <div style="text-align: center; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
        <img src="{{ selected_product.images[0] | image_url: width: 1000 }}" alt="Maletín abierto con el taladro, 2 baterías, cargador y todos los accesorios" loading="lazy" style="display: block; width: 100%; height: 420px; object-fit: contain; margin: 0 auto;">
      </div>
    {% endif %}
    <div>
      <h2 style="font-family: var(--font-titulos); font-size: 32px; font-weight: 800; margin-bottom: 24px; text-align: left;">Todo lo que trae el maletín</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; font-size: 16px;">
        {% for item in selected_product.metafields.landing.incluye.value %}
          <div style="display: flex; align-items: flex-start; gap: 8px;">
            <div style="background: var(--color-grafito, #1A1A1A); border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-naranja, #F2661B)" stroke-width="3"><path d="M20 6L9 17l-5-5"></path></svg>
            </div>
            <span>{{ item }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{ "name": "Landing Incluye", "settings": [{ "type": "product", "id": "main_product", "label": "Producto" }], "presets": [{ "name": "Landing Incluye" }] }
{% endschema %}
