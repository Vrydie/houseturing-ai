<section aria-label="Compra sin riesgo" class="lt">
  <div class="lt__in">
    <div class="lt__i"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F2661B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 10v4M18 10v4"/></svg><span>{{ section.settings.t1 }}</span></div>
    <div class="lt__i"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F2661B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><span>{{ section.settings.t2 }}</span></div>
    <div class="lt__i"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F2661B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg><span>{{ section.settings.t3 }}</span></div>
  </div>
</section>
<style>
  .lt { background: #1D2126; border-top: 1px solid #2E343B; border-bottom: 1px solid #2E343B; padding: 20px; color: #FFFFFF; font-family: 'Barlow', sans-serif; }
  .lt__in { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .lt__i { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; font-size: 13px; font-weight: 600; line-height: 1.3; }
  @media (min-width: 1024px) { .lt__i { font-size: 15px; } }
</style>
{% schema %}
{ "name": "Landing Confianza", "settings": [
  { "type": "text", "id": "t1", "label": "Punto 1", "default": "Pagas en efectivo al recibir" },
  { "type": "text", "id": "t2", "label": "Punto 2", "default": "Envío gratis en 2 a 5 días hábiles" },
  { "type": "text", "id": "t3", "label": "Punto 3", "default": "Garantía de 30 días" } ],
  "presets": [{ "name": "Landing Confianza" }] }
{% endschema %}
