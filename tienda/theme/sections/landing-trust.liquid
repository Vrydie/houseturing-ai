<div style="background: #1D2126; color: white; padding: 24px 20px; text-align: left;">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
    
    <style>
      .trust-item { display: flex; align-items: center; gap: 16px; font-weight: bold; font-family: var(--font-body); font-size: 16px; }
      .trust-icon { color: var(--color-naranja, #F2661B); display: flex; align-items: center; justify-content: center; }
      @media(min-width: 768px) {
        .trust-wrapper { flex-direction: row !important; justify-content: center; gap: 40px !important; }
      }
    </style>

    <div class="trust-wrapper" style="display: flex; flex-direction: column; gap: 16px;">
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/></svg>
        </div>
        Pagas al recibir
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"/><path d="M14 9h4l4 4v5c0 .6-.4 1-1 1h-2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
        </div>
        Envío a todo Colombia
      </div>
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        Garantía de 30 días
      </div>
    </div>

  </div>
</div>
{% schema %}
{ "name": "Landing Trust", "presets": [{ "name": "Landing Trust" }] }
{% endschema %}
