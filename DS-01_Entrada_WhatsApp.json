    {
      "parameters": {
        "jsCode": "\nconst q = $input.first().json.query || {};\nif (q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === 'mi_token_secreto_123') {\n  return [{ json: { \"hub.challenge\": q['hub.challenge'] } }];\n}\nthrow new Error(\"Invalid GET\");\n        "
      },
      "id": "code_get_verify",
      "name": "Verify GET",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        -400
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Try to get from credentials or config\n// R9: n8n uses credentials for secrets in prod, config table for dev.\nreturn [{ json: { secret: 'secret_local_test_12345' } }]; // Match enviar.ps1 for testing\n        "
      },
      "id": "get_secret",
      "name": "Get Secret (Mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst crypto = require('crypto');\nconst secret = $json.secret;\nconst sigHeader = $('Webhook POST').first().json.headers['x-hub-signature-256'] || '';\nconst binaryData = $('Webhook POST').first().binary.data;\n\nif (!binaryData) throw new Error(\"No raw body found\");\n\nconst rawBuffer = Buffer.from(binaryData.data, 'base64');\nconst hmac = crypto.createHmac('sha256', secret).update(rawBuffer).digest('hex');\nconst expectedSig = 'sha256=' + hmac;\n\nif (sigHeader !== expectedSig) {\n  // Use timingSafeEqual in a real app, here we just do string compare for simplicity, or we can use timingSafeEqual if lengths match\n  if (sigHeader.length !== expectedSig.length) throw new Error('Invalid signature length');\n  if (!crypto.timingSafeEqual(Buffer.from(sigHeader), Buffer.from(expectedSig))) {\n    throw new Error('Invalid signature');\n  }\n}\n\nreturn [{ json: $('Webhook POST').first().json.body }];\n        "
      },
      "id": "code_auth",
      "name": "Auth/Parse POST",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst entry = $json.entry[0].changes[0].value;\nif (entry.statuses) return [{ json: { type: 'status', data: entry.statuses[0] } }];\nif (entry.messages) return [{ json: { type: 'message', data: entry.messages[0], contact: entry.contacts[0] } }];\nreturn [];\n        "
      },
