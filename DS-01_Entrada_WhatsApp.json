      "parameters": {
        "jsCode": "\nconst msg = $('Router').first().json.data;\nconst contact = $('Router').first().json.contact;\nreturn [{\n  json: {\n    wa_id: contact.wa_id,\n    nombre_perfil: contact.profile.name,\n    conversacion_id: 1,\n    wamids: [msg.id],\n    texto: msg.text ? msg.text.body : '',\n    tipos: [msg.type],\n    recibido_en: new Date().toISOString()\n  }\n}];\n        "
