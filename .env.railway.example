# ==============================================================================
# Variables de Entorno para HouseTuring en Railway
# ==============================================================================

# 1. Configuración de n8n
N8N_ENCRYPTION_KEY=un_string_aleatorio_muy_seguro_de_al_menos_32_caracteres
N8N_LOG_LEVEL=info
GENERIC_TIMEZONE=America/Bogota
NODE_FUNCTION_ALLOW_BUILTIN=crypto
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false

# 2. Dominio y Webhook de Railway
# Railway asigna automáticamente el dominio en RAILWAY_PUBLIC_DOMAIN si agregas un dominio público al servicio
# o puedes poner directamente la URL completa:
WEBHOOK_URL=https://${RAILWAY_PUBLIC_DOMAIN}

# 3. Base de Datos Postgres (Interna de n8n y Dropship)
# Si usas el servicio de PostgreSQL en Railway, Railway provee estas variables automáticamente:
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${PGHOST}
DB_POSTGRESDB_PORT=${PGPORT}
DB_POSTGRESDB_DATABASE=${PGDATABASE}
DB_POSTGRESDB_USER=${PGUSER}
DB_POSTGRESDB_PASSWORD=${PGPASSWORD}

# 4. WhatsApp y Meta Cloud API
# En Railway el webhook para Meta se configura como: https://TU-DOMINIO.up.railway.app/webhook/whatsapp
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=whatsapp_n8n_verify_2026
WHATSAPP_PROVEEDOR=meta
WHATSAPP_MODO_SIMULADO=false

# 5. Modelos de Inteligencia Artificial (LLM)
# Modelo a usar por el agente de ventas
LLM_MODEL_AGENTE=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# 6. Alertas a Operador Humano (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
