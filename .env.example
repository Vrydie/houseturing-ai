# Inventario de credenciales y configuración del proyecto.
# Copia a .env (NO versionar .env). Los secretos se cargan en "Credenciales" de n8n;
# la config no secreta va en la tabla `config` de Postgres. Este archivo es el checklist.

# ------------------------------------------- n8n del proyecto (infra/.env)
# Instancia propia en Docker. NO se usa ni se modifica el n8n del sistema (:5678).
N8N_HOST_PORT=5690                                 # 127.0.0.1:5690 -> contenedor :5678
WEBHOOK_URL=https://n8n-dev.tudominio.com/
GENERIC_TIMEZONE=America/Bogota
N8N_ENCRYPTION_KEY=                                # guárdala también fuera del servidor
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------- Postgres (BD de negocio)
PG_HOST=postgres                                   # nombre del servicio en docker-compose
PG_PORT=5432                                       # interno; desde el host: 127.0.0.1:5433
PG_DATABASE=dropship
PG_USER=dropship
PG_PASSWORD=

# ------------------------------------------------------------ Meta general
META_GRAPH_VERSION=vXX.0                           # la vigente: developers.facebook.com/docs/graph-api/changelog
META_APP_ID=
META_APP_SECRET=                                   # firma X-Hub-Signature-256
META_SYSTEM_USER_TOKEN=                            # token permanente del usuario del sistema
META_BUSINESS_ID=

# ------------------------------------- WhatsApp (Cloud API vía YCloud, D1 revisada 28-sep-2026)
YCLOUD_API_KEY=                                    # panel YCloud -> Developers -> API Keys (header X-API-Key)
YCLOUD_WEBHOOK_SECRET=                             # whsec_... ; firma YCloud-Signature: t=<unix>,s=<hmac>
YCLOUD_PHONE_NUMBER=                               # +57300... ; campo "from" de los envíos
YCLOUD_WABA_ID=                                    # wabaId ; la CAPI lo usa como whatsapp_business_account_id
YCLOUD_API_BASE_URL=https://api.ycloud.com/v2

# --------------------------- WhatsApp Cloud API directa (en desuso: solo si se sale de YCloud)
WA_WABA_ID=
WA_PHONE_NUMBER_ID=
WA_DISPLAY_PHONE=                                  # 57300...
WA_WEBHOOK_VERIFY_TOKEN=                           # cadena aleatoria que tú defines

# ------------------------------------------------------------ Meta Ads / CAPI
META_AD_ACCOUNT_ID=act_
META_DATASET_ID=                                   # píxel/dataset vinculado a la WABA
META_CAPI_TEST_EVENT_CODE=                         # solo en pruebas; vacío en producción
META_PAGE_ID=                                      # solo si activas Lead Ads

# ------------------------------------------------------------------- Shopify
SHOPIFY_STORE_DOMAIN=tutienda.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=                             # token 24 h + HMAC de webhooks
SHOPIFY_ACCESS_TOKEN=                              # token de 24 h (client credentials); lo usan los scripts de tienda/scripts
SHOPIFY_VARIANT_GID=gid://shopify/ProductVariant/  # solo para la prueba F0.4; luego vive en productos.shopify_variant_gid
SHOPIFY_LOCATION_ID=gid://shopify/Location/
SHOPIFY_THEME_ACCESS_PASSWORD=                     # app Theme Access; la usa Shopify CLI (OT-02)

# --------------------------------------------------------------------- Dropi
DROPI_SHOPIFY_TOKEN=                               # "Mis Integraciones" (se pega en Dropify)
DROPI_API_BASE_URL=                                # la entrega Dropi (pruebas ≠ producción)
DROPI_INTEGRATION_KEY=                             # header dropi-integration-key

# ------------------------------------------------ Módulo P (selección de productos)
ML_APP_ID=                                         # MercadoLibre (opcional)
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
SERPAPI_KEY=                                       # Google Shopping CO (Falabella, Alkosto, Homecenter…) + Google Trends (pago por búsqueda)
ALIEXPRESS_APP_KEY=                                # API oficial de afiliados (cuenta gratuita)
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# ----------------------------------------------------------------------- LLM
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_AGENTE=
LLM_MODEL_TRANSCRIPCION=                           # speech-to-text para notas de voz

# ------------------------------------------------------------------ Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_OPERADOR=

# ------------------------------------------------------------------- Negocio
PAIS=CO
MONEDA=COP

# ------------------------------- OT-06 prueba Shopify -> Dropi (datos reales del dueño, nunca versionados)
PRUEBA_NOMBRE=
PRUEBA_APELLIDO=
PRUEBA_CELULAR=                                    # 10 dígitos, empieza por 3, sin +57
PRUEBA_DIRECCION=                                  # entre comillas si lleva #
PRUEBA_BARRIO=
PRUEBA_CIUDAD=                                     # como la escribe Dropi, p. ej. Cali
PRUEBA_PROVINCE_CODE=                              # código de Shopify, p. ej. VAC
